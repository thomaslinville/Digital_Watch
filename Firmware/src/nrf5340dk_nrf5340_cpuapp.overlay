/*
 * Bring-up overlay for nRF5340 DK (app core). Sensors on breakouts, powered
 * from the bench supply (common GND with the DK).
 *
 * nRF5340 serial instances 0-3 are shared between UARTE/SPIM/TWIM, so each
 * instance can be only ONE of them. uart0 stays as the DK console (VCOM).
 *   instance 0 -> uart0  (console, stock)
 *   instance 1 -> i2c1   (IMU + PPG)
 *   instance 2 -> i2c2   (touch, placeholder)
 *   instance 3 -> uart3  (GPS)
 *   spi4       -> display (placeholder, disabled)
 * Pin numbers are placeholders: confirm against the DK header silkscreen and
 * check build/zephyr/zephyr.dts for conflicts with stock DK nodes.
 */

&pinctrl {
	i2c1_default: i2c1_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,
				<NRF_PSEL(TWIM_SCL, 1, 3)>;
		};
	};
	i2c1_sleep: i2c1_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,
				<NRF_PSEL(TWIM_SCL, 1, 3)>;
			low-power-enable;
		};
	};
	i2c2_default: i2c2_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 4)>,
				<NRF_PSEL(TWIM_SCL, 1, 5)>;
		};
	};
	i2c2_sleep: i2c2_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 4)>,
				<NRF_PSEL(TWIM_SCL, 1, 5)>;
			low-power-enable;
		};
	};
	uart3_default: uart3_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 6)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 7)>;
			bias-pull-up;
		};
	};
	uart3_sleep: uart3_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 6)>,
				<NRF_PSEL(UART_RX, 1, 7)>;
			low-power-enable;
		};
	};
};

/* IMU + PPG bus */
&i2c1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c1_default>;
	pinctrl-1 = <&i2c1_sleep>;
	pinctrl-names = "default", "sleep";

	bmi270: bmi270@68 {
		compatible = "bosch,bmi270";
		reg = <0x68>;
	};

	/* MAX30102 uses the MAX30101 driver; led slots 1=red, 2=IR,
	 * and 0 disables the unused third slot. */
	max30102: max30102@57 {
		compatible = "maxim,max30101";
		reg = <0x57>;
		acq-mode = "multi-led";
	};
};

/* Touch bus: TMA525B has no upstream Zephyr driver, so no child node yet.
 * Enabled only so `i2c scan i2c2` works if you wire the breakout. */
&i2c2 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c2_default>;
	pinctrl-1 = <&i2c2_sleep>;
	pinctrl-names = "default", "sleep";
};

/* GPS NMEA, SAM-M10Q default 9600 baud */
&uart3 {
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart3_default>;
	pinctrl-1 = <&uart3_sleep>;
	pinctrl-names = "default", "sleep";
};

/* Display (SH8601A): no upstream driver, bring up after the buses work.
 * Place the node under &spi4 once you write the binding + driver. */
&spi4 {
	status = "disabled";
};
